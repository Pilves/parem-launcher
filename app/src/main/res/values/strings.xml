    <string name="quiet_card_hint" translatable="false">A short sound or vibration may still play when a notification arrives. Use \'Make silent\' to stop it for an app. Open the quiet list with a swipe: Settings > Gestures.</string>
    <string name="quiet_card_needs_access" translatable="false">Needs notification access. Tap \'Needs access\' to open settings.</string>
