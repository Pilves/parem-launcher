<resources>

    <!-- Everything that does not change between light and dark. AppTheme adds the colours;
         values-night/styles.xml overrides AppTheme with colour items only (DESIGN 5). -->
    <style name="Base.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:forceDarkAllowed">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorEdgeEffect">@android:color/transparent</item>

        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <item name="colorPrimaryDark">@android:color/darker_gray</item>

        <item name="mainFontFamily">sans-serif-light</item>

    </style>

    <style name="AppTheme" parent="Base.AppTheme">
        <item name="colorPrimary">@color/black</item>
        <item name="colorAccent">@color/black</item>

        <item name="primaryColor">@color/black</item>
        <item name="primaryInverseColor">@color/white</item>
        <item name="primaryTextShadowColor">@color/whiteTrans50</item>
        <item name="primaryColorTrans50">@color/blackTrans50</item>
        <item name="primaryColorTrans60">@color/blackTrans60</item>
        <item name="primaryColorTrans80">@color/blackTrans80</item>
        <item name="primaryColorInverseTrans80">@color/whiteTrans80</item>
        <item name="primaryShadeColor">@color/whiteTrans10</item>
        <item name="primaryShadeDarkColor">@color/whiteTrans25</item>
        <item name="surfaceScrimColor">@color/whiteTrans85</item>
        <item name="wallpaperDimColor">@color/whiteTrans35</item>
    </style>

    <!-- Applied over AppTheme in MainActivity when bold font is on -->
    <style name="BoldFontOverlay">
        <item name="mainFontFamily">sans-serif</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="AppSearchText" parent="Widget.AppCompat.SearchView">
        <item name="android:maxLength">200</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:editTextColor">?attr/primaryColor</item>
        <item name="android:textColorHint">?attr/primaryColor</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:inputType">textCapSentences|textNoSuggestions</item>
    </style>

    <!-- DESIGN 3.2 type scale. Sizes come from dimens (values / values-sw600dp). -->
    <style name="TextAppearance.Parem" parent="@android:style/TextAppearance">
        <item name="android:textColor">@drawable/text_colors_default</item>
        <item name="android:textColorHint">?attr/primaryColorTrans80</item>
    </style>

    <style name="TextAppearance.Parem.Display">
        <item name="android:textSize">@dimen/time_size</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
    </style>

    <style name="TextAppearance.Parem.Subtitle">
        <item name="android:textSize">@dimen/date_size</item>
    </style>

    <style name="TextAppearance.Parem.Title">
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
    </style>

    <style name="TextAppearance.Parem.Body">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="TextAppearance.Parem.Label">
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="TextAppearance.Parem.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/primaryColorTrans80</item>
    </style>

    <!-- Only for text drawn directly on the wallpaper (home). Text on a scrim or surface has no shadow. -->
    <style name="TextOnWallpaper">
        <item name="android:shadowColor">?attr/primaryTextShadowColor</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <!-- Legacy layout styles, kept as thin aliases of the appearances above -->
    <style name="TextDefault" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@drawable/text_colors_default</item>
        <item name="android:textColorHint">?attr/primaryColorTrans80</item>
    </style>

    <style name="TextLarge" parent="TextDefault">
        <item name="android:textAppearance">@style/TextAppearance.Parem.Title</item>
    </style>

    <style name="TextSmall" parent="TextDefault">
        <item name="android:textAppearance">@style/TextAppearance.Parem.Body</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <style name="TextSmallBold" parent="TextSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextSmallLight" parent="TextSmall">
        <item name="android:textColor">@drawable/text_colors_light</item>
    </style>

</resources>
