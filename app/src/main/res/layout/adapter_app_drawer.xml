<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/appTitle"
        style="@style/TextLarge"
        android:background="@drawable/bg_focus_highlight"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="80dp"
        android:paddingVertical="@dimen/app_padding_vertical"
        android:text="@string/app" />

    <TextView
        android:id="@+id/appUsageTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:paddingEnd="20dp"
        android:textSize="12sp"
        android:alpha="0.5"
        android:visibility="gone"
        tools:text="1h 23m"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/otherProfileIndicator"
        android:contentDescription="@string/a11y_work_profile"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:src="@drawable/ic_rounded"
        app:tint="?attr/primaryColor" />

</FrameLayout>
