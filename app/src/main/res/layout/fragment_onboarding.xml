<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor">

    <!-- Screen 1: make Parem the home screen -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/content_side_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="96dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/TextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:shadowRadius="0"
                android:text="@string/onboarding_home_screen_title"
                android:textColor="?attr/primaryColor" />

            <TextView
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:shadowRadius="0"
                android:text="@string/onboarding_home_screen_body"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/onboarding_home_screen_reassure"
                android:textColor="?attr/primaryColorTrans80"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSetHome"
                style="@style/TextSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:shadowRadius="0"
                android:text="@string/onboarding_set_home"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/btnNotNow"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:shadowRadius="0"
                android:text="@string/not_now"
                android:textColor="?attr/primaryColorTrans50" />

        </LinearLayout>
    </ScrollView>

    <!-- Screen 2: optional Calm-phone setup; not tapping a row is the skip -->
    <ScrollView
        android:id="@+id/calmScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/content_side_padding"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/calmRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="96dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/TextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:shadowRadius="0"
                android:text="@string/onboarding_calm_title"
                android:textColor="?attr/primaryColor" />

            <TextView
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:shadowRadius="0"
                android:text="@string/onboarding_calm_body"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/calmFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:text="@string/onboarding_footer"
                android:textColor="?attr/primaryColorTrans80"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnDone"
                style="@style/TextSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:shadowRadius="0"
                android:text="@string/onboarding_done"
                android:textColor="?attr/primaryColor" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
