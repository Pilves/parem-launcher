<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad/keyboard focus marker. Touch never focuses these views (not
     focusableInTouchMode), so it stays invisible for touch users. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/primaryShadeDarkColor" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/primaryColorTrans50" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
