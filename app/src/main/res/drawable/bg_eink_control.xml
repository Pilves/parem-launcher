<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="?attr/surfaceColor"/><stroke android:width="1dp" android:color="?attr/textColor"/><corners android:radius="@dimen/corner_control"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="?attr/surfaceColor"/><stroke android:width="1dp" android:color="?attr/textColor"/><corners android:radius="@dimen/corner_control"/></shape></item>
    <item android:drawable="@android:color/transparent"/>
</selector>
